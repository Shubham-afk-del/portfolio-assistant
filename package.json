{
  "name": "portfolio-assistant",
  "version": "0.1.0",
  "description": "Retrieval-grounded assistant answering questions about Shubham Kumar Singh, with a measured retrieval pipeline and an eval harness that gates deploys.",
  "scripts": {
    "predev": "tsx scripts/check-profile.ts",
    "dev": "next dev",
    "prebuild": "tsx scripts/check-profile.ts",
    "build": "next build",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint .",
    "profile:check": "tsx scripts/check-profile.ts",
    "ingest": "tsx --env-file-if-exists=.env.local ingest/run.ts",
    "search": "tsx --env-file-if-exists=.env.local scripts/search.ts"
  },
  "dependencies": {
    "@ai-sdk/react": "^4.0.136",
    "@radix-ui/react-use-controllable-state": "^1.2.6",
    "@streamdown/cjk": "^1.0.4",
    "@streamdown/code": "^2.0.0",
    "@streamdown/math": "^1.0.3",
    "@streamdown/mermaid": "^1.0.3",
    "ai": "^7.0.133",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.4.0",
    "embla-carousel-react": "^8.6.0",
    "lucide-react": "^1.53.0",
    "motion": "^14.0.0",
    "nanoid": "^6.0.2",
    "next": "^16.4.0",
    "radix-ui": "^1.7.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "shadcn": "^4.21.4",
    "shiki": "^4.5.0",
    "streamdown": "^2.7.0",
    "tw-animate-css": "^1.4.0",
    "use-stick-to-bottom": "^1.1.6",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3"
  },
  "private": true
}
