# ---------------------------------------------------------------------------
# Every key the later phases need. No real values in this file, ever.
# Model IDs and thresholds are NOT here: they live in lib/config.ts, which is
# the single source of truth for them (SPEC-v2 §6).
#
# Phase 0 needs none of these. The app builds and runs with this file unset.
# ---------------------------------------------------------------------------

# --- Reranking, generation and the faithfulness judge (Phase 2 to 5) -------
# Gemini free tier, no card required. aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY=

# --- Fast stages: query rewrite, chunk contextualisation, fallback classify -
# Groq free tier. Roughly 30 RPM / 1,000 RPD: RPD is the binding constraint
# on eval runs (ZERO-COST-STACK §6). console.groq.com/keys
GROQ_API_KEY=

# --- Embeddings (Phase 1, 2) ----------------------------------------------
# Voyage. Used at ingestion time and for ~20-token query embeddings. Its
# reranker is the swap for Gemini's: see MODELS.rerank in lib/config.ts.
VOYAGE_API_KEY=

# --- Optional generation failover (Phase 3) --------------------------------
# Only if the eval numbers justify paying for the generation stage.
ANTHROPIC_API_KEY=

# --- Mutable state: conversations, escalations, stats counters (Phase 3, 8) -
# The corpus is immutable and build-time generated, so it needs no database.
# This store exists only for data that genuinely changes.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- GitHub loader (Phase 1) ----------------------------------------------
# Read-only PAT for the repo allowlist: READMEs, selected source files, commit
# history summaries. Also used by github_activity(), cached 6h.
GITHUB_TOKEN=

# --- Escalation relay (Phase 8.5) -----------------------------------------
# @BotFather gives the bot token. The secret is verified on every webhook call.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_OWNER_CHAT_ID=

# --- Optional: email delivery of escalation answers (Phase 8.5) -----------
# Telegram plus the conversation permalink already closes the loop without it.
RESEND_API_KEY=

# --- Observability (Phase 8) ----------------------------------------------
SENTRY_DSN=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=

# --- Experiment tracking (Phase 6, 9) -------------------------------------
WANDB_API_KEY=

# --- Contact details shown in the profile panel ----------------------------
# The phone number lives here rather than in content/profile.yaml so it never
# lands in the committed repo. Leave it empty and the phone row is omitted.
# Format it as it should be displayed, e.g. "+44 7700 900123".
CONTACT_PHONE=

# --- Deployment -----------------------------------------------------------
# Absolute origin, used for permalinks and OG images. No trailing slash.
# Only for a custom domain: left empty, a Vercel build uses the project's
# production domain and a local one uses localhost (app/layout.tsx).
NEXT_PUBLIC_SITE_URL=
